    "test:project-monitoring": "node --test tests/project-monitoring.test.mjs",
    "test:employee-worksites": "node --test tests/current-employee-sites.test.mjs",
    "test:purchases": "node --test tests/purchase-budget.test.mjs",
    "test:deliveries": "node --test tests/delivery-reconciliation.test.mjs",
